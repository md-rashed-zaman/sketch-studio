        "mint": "#0C9B6A",
        "coral": "#E14B34",
        "violet": "#7650DE"
      },
      "marker": {
        "stroke": "#F08C00",
        "text": "#A85A00",
        "strokePx": 7
      },
      "emphasis": {
        "mode": "tint",
        "glowRadiusPx": 0,
        "glowOpacity": 0,
