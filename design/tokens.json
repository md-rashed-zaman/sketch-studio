{
  "$schema-note": "Eigenbit design tokens v2 (2026-11-06). `theme` picks the active palette from `themes`: 'day' (Day Paper, warm cream, active) or 'night' (Night Paper v1, warm dark, kept for later). Source of truth for the Sketch Studio kit. See 02-design-system.md.",
  "theme": "day",
  "themes": {
    "day": {
      "paper": {
        "canvas": "#F5F0E6",
        "raised": "#FFFDF9",
        "grid": "#DED5C5",
        "card": "#262320"
