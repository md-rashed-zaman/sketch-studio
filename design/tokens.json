        "mint": "#3FD39B",
        "coral": "#FF6F59",
        "violet": "#AE92FF"
      },
      "marker": {
        "stroke": "#FFB547",
        "text": "#FFB547",
        "strokePx": 5
      },
      "emphasis": {
        "mode": "glow",
        "glowRadiusPx": 12,
        "glowOpacity": 0.35,
        "tintOpacity": 0,
        "stateStrokePx": 3
      },
      "iconStroke": {
        "inNode": 1.25,
        "free": 1.1
      },
      "secondaryWeight": 500
