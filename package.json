{
  "name": "sketch-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "voice": "bash tools/voice.sh",
    "align": "uv run python tools/align.py",
    "srt": "uv run python tools/srt.py",
    "sheet": "tsx tools/sheet.ts",
    "render": "remotion render",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && uv run pytest -q tools",
    "stills": "tsx tools/stills.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/captions": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/layout-utils": "4.0.526",
    "@remotion/media-utils": "4.0.526",
    "@remotion/paths": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "lucide-react": "1.54.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
